# For host-side Prisma tooling (prisma studio, migrate) against the compose db.
DATABASE_URL="postgresql://medimate:medimate@localhost:5432/medimate"

# Postgres credentials for compose (docker compose reads this file for ${...}).
POSTGRES_USER=medimate
POSTGRES_PASSWORD=medimate
POSTGRES_DB=medimate

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
# Comma-separated frontend origins allowed to call the auth API in production.
AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Google and Facebook OAuth credentials. Keep client secrets server-side.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Local Mailpit defaults. Production should use the company's SMTP values.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_AUTH_REQUIRED=false
SMTP_USER=""
SMTP_PASSWORD=""
AUTH_EMAIL_FROM="MediMate <no-reply@medimate.local>"

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
