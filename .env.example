# For host-side Prisma tooling (prisma studio, migrate) against the compose db.
DATABASE_URL="postgresql://medimate:medimate@localhost:5432/medimate"

# Postgres credentials for compose (docker compose reads this file for ${...}).
POSTGRES_USER=medimate
POSTGRES_PASSWORD=medimate
POSTGRES_DB=medimate

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# Local Mailpit defaults. Replace these values for a deployed mail service.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
AUTH_EMAIL_FROM="MediMate <no-reply@medimate.local>"

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=