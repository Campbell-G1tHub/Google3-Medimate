# Build-context exclusions for the app image (and the postgres image build).
# Keeps the image small and prevents host state (deps, builds, secrets)
# from leaking into it.

.git
node_modules
.pnpm-store
.next
out
.env
.env.*
!.env.example
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
coverage
prisma/*.db
prisma/*.db-journal
