generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  CV
  ID
  IMAGE
  DOCUMENT
}

model Document {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  volunteerId            String                @map("volunteer_id") @db.Uuid
  type                   DocumentType
  name                   String
  url                    String
  uploadedAt             DateTime              @default(now()) @map("uploaded_at") @db.Timestamptz(0)
  uploader               Volunteer             @relation(fields: [volunteerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "document_volunteer_id_foreign")
  volunteerInformation   VolunteerInformation? @relation(fields: [volunteerInformationId], references: [id])
  volunteerInformationId String?               @db.Uuid

  @@map("documents")
}

model EmergencyContact {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  declarantId           String                 @unique(map: "emergency_contacts_volunteer_id_unique") @map("declarant_id") @db.Uuid
  fullName              String                 @map("full_name")
  email                 String
  relationship          String
  phoneNumber           String                 @map("phone_number")
  declarant             Volunteer              @relation(fields: [declarantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "emergency_contact_volunteer_id_foreign")
  volunteerInformations VolunteerInformation[]

  @@map("emergency_contacts")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  post      Post     @relation(fields: [postId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "notification_post_id_foreign")

  @@map("notifications")
}

model Notification_Permission {
  id          String    @id @db.Uuid
  volunteerId String    @map("volunteer_id") @db.Uuid
  endpoint    String
  p256dh      String
  auth        String
  createdAt   DateTime  @map("created_at") @db.Timestamptz(0)
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "notification_permission_volunteer_id_foreign")

  @@map("notification_permissions")
}

model Post {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String?         @map("event_id") @db.Uuid
  groupId         String?         @map("group_id") @db.Uuid
  authorId        String          @map("author_id") @db.Uuid
  title           String
  body            String
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(0)
  notifications   Notification[]
  recipientGroups VolunteerGroup? @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "post_volunteer_group_id_foreign")
  author          Volunteer       @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "post_volunteer_id_foreign")
  origin          Event?          @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "post_event_id_foreign")

  @@map("posts")
}

model Referees {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  volunteerId            String                @map("volunteer_id") @db.Uuid
  referralMessage        String                @map("referral_message")
  volunteer              Volunteer             @relation(fields: [volunteerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "referee_volunteer_id_foreign")
  volunteerInformation   VolunteerInformation? @relation(fields: [volunteerInformationId], references: [id])
  volunteerInformationId String?               @db.Uuid

  @@map("referees")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique(map: "session_token_unique")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(0)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz(0)
  user      Volunteer @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "session_volunteer_id_foreign")

  @@index([userId])
  @@map("sessions")
}

enum volunteerRole {
  ADMIN
  VOLUNTEER
}

model Volunteer {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String
  email                     String                     @unique(map: "volunteer_email_unique")
  emailVerified             Boolean                    @default(false) @map("email_verified")
  onboardingCompleted       Boolean                    @default(false) @map("onboarding_completed")
  image                     String?
  role                      volunteerRole              @default(VOLUNTEER)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt                 DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(0)
  accounts                  Account[]
  posts                     Post[]
  sessions                  Session[]
  events                    Event[]
  information               VolunteerInformation?
  documents                 Document[]
  emergencyContact          EmergencyContact?
  referees                  Referees[]
  volunteerGroupPreferences VolunteerGroupPreference[]
  eventAttendees            EventAttendee[]
  notificationPermissions   Notification_Permission[]

  @@map("volunteers")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  issuer                String
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(0)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(0)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(0)
  user                  Volunteer @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "account_volunteer_id_foreign")

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  token      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(0)

  @@index([identifier])
  @@map("verifications")
}

model VolunteerGroup {
  id              String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String                     @unique(map: "volunteer_group_name_unique")
  description     String?
  posts           Post[]
  groupSelections VolunteerGroupPreference[]
  events          Event[]

  @@map("volunteer_groups")
}

model VolunteerGroupPreference {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  volunteerId            String                @map("volunteer_id") @db.Uuid
  groupId                String                @map("group_id") @db.Uuid
  group                  VolunteerGroup        @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "volunteer_group_preference_volunteer_group_id_foreign")
  volunteer              Volunteer             @relation(fields: [volunteerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "volunteer_group_preference_volunteer_id_foreign")
  volunteerInformation   VolunteerInformation? @relation(fields: [volunteerInformationId], references: [id])
  volunteerInformationId String?               @db.Uuid

  @@map("volunteer_group_preferences")
}

enum EventStatus {
  DRAFT
  PENDING_START
  IN_PROGRESS
  ENDED
  CANCELLED
}

model Event {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId        String          @map("creator_id") @db.Uuid
  title            String
  description      String
  location         String?
  startsAt         DateTime?       @map("starts_at") @db.Timestamptz(0)
  endsAt           DateTime?       @map("ends_at") @db.Timestamptz(0)
  status           String          @default("OPEN") @db.VarChar(255)
  createdTime      DateTime        @default(now()) @map("created_time") @db.Timestamptz(0)
  updatedTime      DateTime        @default(now()) @map("updated_time") @db.Timestamptz(0)
  posts            Post[]
  creator          Volunteer       @relation(fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "event_creator_id_foreign")
  attendees        EventAttendee[]
  volunteerGroup   VolunteerGroup? @relation(fields: [volunteerGroupId], references: [id])
  volunteerGroupId String?         @db.Uuid

  @@map("events")
}

enum AttendeeStatus {
  ATTENDING
  NOT_ATTENDING
}

model EventAttendee {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  volunteerId String         @map("volunteer_id") @db.Uuid
  status      AttendeeStatus @default(ATTENDING)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(0)
  event       Event          @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "event_attendee_event_id_foreign")
  attendee    Volunteer      @relation(fields: [volunteerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "event_attendees")

  @@map("event_attendees")
}

model VolunteerInformation {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  volunteerId         String                     @unique(map: "volunteer_profiles_user_id_unique") @map("volunteer_id") @db.Uuid
  firstName           String                     @map("first_name")
  lastName            String                     @map("last_name")
  address             String
  mobile              String
  dateOfBirth         DateTime                   @map("date_of_birth") @db.Date
  motivation          String
  skillsAndStrengths  String                     @map("skills_and_strengths")
  medicalConditions   String?                    @map("medical_conditions")
  carType             String?                    @map("car_type")
  frequentSuburbs     String?                    @map("frequent_suburbs")
  frequency           String                     @db.VarChar(255)
  availability        String                     @db.VarChar(255)
  agreementAccepted   Boolean                    @map("agreement_accepted")
  agreementAcceptedAt DateTime?                  @map("agreement_accepted_at") @db.Timestamptz(0)
  policeCheckConsent  Boolean                    @map("police_check_consent")
  newsletterOptIn     Boolean                    @map("newsletter_opt_in")
  referralSources     String                     @map("referral_sources") @db.VarChar(255)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(0)
  documents           Document[]
  emergencyContacts   EmergencyContact?          @relation(fields: [emergencyContactId], references: [id])
  referees            Referees[]
  groups              VolunteerGroupPreference[]
  volunteer           Volunteer                  @relation(fields: [volunteerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "volunteer_information_volunteer_id_foreign")
  emergencyContactId  String?                    @db.Uuid
}
